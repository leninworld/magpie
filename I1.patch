+def test_linked_notice_reader_is_silent_without_husky_and_never_writes(tmp_path: Path) -> None:
+    main = git_repo(tmp_path / "main")
+    admin = main / ".git/worktrees/linked"
+    admin.mkdir(parents=True)
+    linked = tmp_path / "linked"
+    linked.mkdir()
+    (linked / ".git").write_text(f"gitdir: {admin}\n")
+    (admin / "commondir").write_text("../..\n")
+    config = main / ".git/config"
+    original = config.read_bytes()
+    assert isolated._linked_husky_notice(linked) == []
+    assert config.read_bytes() == original
+    with config.open("a") as handle:
+        handle.write("[core]\nhooksPath = .husky/_\n")
+    before = config.read_bytes()
+    assert "start a session in the main checkout" in isolated._linked_husky_notice(linked)[0]
+    assert config.read_bytes() == before
