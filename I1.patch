+def normalise_thread_id(value: str) -> str:
+    """Canonicalise a caller's single ID without changing header parsing."""
+    token = value.strip()
+    if "<" not in token and ">" not in token:
+        token = f"<{token}>"
+    return token if _MSG_ID.fullmatch(token) else value
+
