+def test_real_husky_failure_and_the_session_reinstall_boundary(
+    real_husky_repo: tuple[Path, Path, Path], isolated_home: Path, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    repo, seen, framework = real_husky_repo
+    # Original behavior: the repository override bypasses host-home selection.
+    command(repo, "git", "commit", "-qm", "baseline")
+    assert seen.read_text() == "unset"
+    isolated.session_start(repo, home=isolated_home)
+    command(repo, "git", "commit", "--allow-empty", "-qm", "candidate")
+    assert seen.read_text() == str(isolated_home / ".local/share/prek-host")
+    before = command(repo, "git", "rev-parse", "HEAD").stdout
+    monkeypatch.setenv("REPO_HOOK_STATUS", "7")
+    assert command(repo, "git", "commit", "--allow-empty", "-qm", "must fail", check=False).returncode != 0
+    assert command(repo, "git", "rev-parse", "HEAD").stdout == before
+    monkeypatch.delenv("REPO_HOOK_STATUS")
+    command(repo, "git", "checkout", "-qb", "both-hooks")
+    assert framework.read_text() == "framework"
+    assert seen.read_text().endswith("repository")
+    # A real offline reinstall restores the override until the next session.
+    command(repo, "npm", "install", "--offline", "--no-audit", "--no-fund")
+    command(repo, "git", "commit", "--allow-empty", "-qm", "unreconciled window")
+    assert seen.read_text() == "unset"
+    isolated.session_start(repo, home=isolated_home)
+    command(repo, "git", "commit", "--allow-empty", "-qm", "reconciled")
+    assert seen.read_text() == str(isolated_home / ".local/share/prek-host")
+    assert command(repo, "git", "config", "--get-all", "magpie.localHooksPath").stdout == ".husky/_\n"
+
+
+def test_real_husky_uses_each_linked_worktrees_wrapper(
+    real_husky_repo: tuple[Path, Path, Path], isolated_home: Path,
+) -> None:
+    repo, seen, framework = real_husky_repo
+    command(repo, "git", "commit", "-qm", "initial")
+    isolated.session_start(repo, home=isolated_home)
+    linked = repo.parent / "linked"
+    command(repo, "git", "worktree", "add", "-qb", "linked", str(linked))
+    (linked / ".claude").mkdir()
+    command(linked, "npm", "install", "--offline", "--no-audit", "--no-fund")
+    # A linked-only session reports the shared override and changes nothing.
+    config = repo / ".git/config"
+    before = config.read_bytes()
+    assert "start a session in the main checkout" in isolated.session_start(linked, home=isolated_home)
+    assert config.read_bytes() == before
+    isolated.session_start(repo, home=isolated_home)
+    (linked / ".husky/pre-commit").write_text('printf linked > "$REPO_SEEN"\n')
+    command(linked, "git", "commit", "--allow-empty", "-qm", "linked hook")
+    assert seen.read_text() == "linked"
+    (linked / ".husky/post-checkout").write_text('printf linked-checkout > "$REPO_SEEN"\n')
+    command(linked, "git", "checkout", "-qb", "linked-next")
+    assert seen.read_text() == "linked-checkout"
+    assert framework.read_text() == "framework"
