+def husky_checkout(tmp_path: Path) -> Path:
+    repo = git_repo(tmp_path / "repo")
+    (repo / ".husky" / "_").mkdir(parents=True)
+    subprocess.run(["git", "-C", str(repo), "config", "core.hooksPath", ".husky/_"], check=True)
+    return repo
+
+
+def saved_hooks_paths(repo: Path) -> list[str]:
+    done = subprocess.run(
+        ["git", "config", "--file", str(repo / ".git" / "config"), "--get-all", "magpie.localHooksPath"],
+        capture_output=True, text=True, check=False,
+    )
+    return done.stdout.splitlines()
+
