+def test_caller_thread_ids_are_canonical_and_idempotent() -> None:
+    from imap_source.threads import normalise_thread_id
+
+    for value in ("a@b", "<a@b>", "  a@b  ", "  <a@b>  "):
+        result = normalise_thread_id(value)
+        assert result == "<a@b>"
+        assert normalise_thread_id(result) == result
+    # The existing token grammar does not require an @; don't add a new rule.
+    assert normalise_thread_id("local-token") == "<local-token>"
+    assert normalise_message_id("a@b") is None
+
+
+def test_caller_thread_ids_do_not_reinterpret_invalid_or_multiple_tokens() -> None:
+    from imap_source.threads import normalise_thread_id
+
+    for value in ("", "  ", "<abc", "abc>", "a b", "<a@b> <c@d>", "a@b c@d", "(was) <a@b>"):
+        assert normalise_thread_id(value) == value
