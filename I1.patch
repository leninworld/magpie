+"""Real npm/Husky integration, offline with an explicitly supplied pinned archive.
+
+Set MAGPIE_HUSKY_TARBALL to the official husky-9.1.7.tgz. The full validation
+lane supplies it after verifying its registry integrity; no test downloads it.
+Use a pytest --basetemp outside the implicit sandbox temporary-write roots to
+exercise host-default init protection with a synthetic HOME (for example a
+dedicated /fixtures tmpfs inside the validation container).
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from setup_preflight import isolated
+
+ROOT = Path(__file__).resolve().parents[3]
+DISPATCHER = ROOT / "tools/agent-isolation/git-hook-dispatcher.sh"
+INTEGRITY = "sha512-5gs5ytaNjBrh5Ow3zrvdUUY+0VxIuWVL4i9irt6friV+BqdCfmV11CQTWMiBYWHbXhco+J1kHfTOUkePhCDvMA=="
+
+
+def command(cwd: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(args, cwd=cwd, text=True, capture_output=True, check=check, timeout=30)
+
+
+@pytest.fixture
+def real_husky_repo(
+    tmp_path: Path, isolated_home: Path, monkeypatch: pytest.MonkeyPatch,
+) -> tuple[Path, Path, Path]:
+    name = os.environ.get("MAGPIE_HUSKY_TARBALL")
+    if not name:
+        pytest.skip("real offline Husky integration requires MAGPIE_HUSKY_TARBALL")
+    archive = Path(name).resolve(strict=True)
+    raw = archive.read_bytes()
+    assert len(raw) == 2448
+    assert "sha512-" + base64.b64encode(hashlib.sha512(raw).digest()).decode() == INTEGRITY
+    for key in ("SANDBOX_RUNTIME", "PREK_HOME", "XDG_CACHE_HOME", "XDG_CONFIG_HOME", "CLAUDE_CONFIG_DIR", "HUSKY"):
+        monkeypatch.delenv(key, raising=False)
+    hooks = isolated_home / ".claude/git-hooks"
+    hooks.mkdir(parents=True)
+    for hook in ("post-checkout", "pre-commit", "pre-push"):
+        (hooks / hook).symlink_to(DISPATCHER)
+    # The session-start identity check requires the canonical source basename.
+    (hooks / "git-hook-dispatcher.sh").symlink_to(DISPATCHER)
+    (isolated_home / ".gitconfig").write_text(
+        f'[core]\n hooksPath = "{hooks}"\n[user]\n name = Test\n email = test@example.invalid\n[commit]\n gpgsign = false\n'
+    )
+    scripts = isolated_home / ".claude/scripts"
+    scripts.mkdir()
+    sync = scripts / "sandbox-add-project-root.sh"
+    sync.write_text('#!/bin/sh\nprintf framework >> "$FRAMEWORK_SEEN"\n')
+    sync.chmod(0o755)
+    repo = tmp_path / "repo"
+    command(tmp_path, "git", "init", "-q", str(repo))
+    (repo / ".claude").mkdir()
+    (repo / "package.json").write_text(json.dumps({
+        "name": "husky-integration", "version": "1.0.0", "private": True,
+        "scripts": {"prepare": "husky"},
+        "devDependencies": {"husky": "file:" + os.path.relpath(archive, repo)},
+    }))
+    (repo / ".gitignore").write_text("node_modules/\n.claude/\n")
+    command(repo, "npm", "install", "--offline", "--no-audit", "--no-fund")
+    lock = json.loads((repo / "package-lock.json").read_text())
+    assert lock["packages"]["node_modules/husky"]["integrity"] == INTEGRITY
+    # npm prepare must have run the actual package, not a simulated transport.
+    assert command(repo, "git", "config", "--get", "core.hooksPath").stdout.strip() == ".husky/_"
+    seen = tmp_path / "repo-seen"
+    framework = tmp_path / "framework-seen"
+    monkeypatch.setenv("REPO_SEEN", str(seen))
+    monkeypatch.setenv("FRAMEWORK_SEEN", str(framework))
+    (repo / ".husky/pre-commit").write_text('printf "%s" "${PREK_HOME:-unset}" > "$REPO_SEEN"\nexit "${REPO_HOOK_STATUS:-0}"\n')
+    (repo / ".husky/post-checkout").write_text('printf repository >> "$REPO_SEEN"\n')
+    command(repo, "git", "add", "package.json", "package-lock.json", ".gitignore")
+    return repo, seen, framework
