+def _husky_hook(tmp_path: Path) -> tuple[Path, Path, Path, Path]:
+    repo, hook, seen = _repo_with_local_hook(tmp_path)
+    home = tmp_path / "home"
+    home.mkdir()
+    local = repo / ".husky" / "_" / "pre-commit"
+    local.parent.mkdir(parents=True)
+    local.write_text('#!/bin/sh\nprintf "%s" "$*" > "$HUSKY_SEEN"\ncat >> "$HUSKY_SEEN"\nexit "${HOOK_STATUS:-0}"\n')
+    local.chmod(0o755)
+    subprocess.run(["git", "-C", str(repo), "config", "magpie.localHooksPath", ".husky/_"], check=True)
+    return repo, hook, seen, home
+
+
+def _run_husky(
+    repo: Path, hook: Path, seen: Path, home: Path, **extra: str
+) -> subprocess.CompletedProcess[str]:
+    env = {k: v for k, v in os.environ.items() if k not in (
+        "SANDBOX_RUNTIME", "XDG_CONFIG_HOME", "CLAUDE_CONFIG_DIR", "GIT_CONFIG_COUNT",
+        "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM",
+    )}
+    env.update(HOME=str(home), HUSKY_SEEN=str(seen), SANDBOX_RUNTIME="1")
+    env.update(extra)
+    return subprocess.run(["bash", str(hook), "first", "two words"], cwd=repo, env=env,
+                          input="stdin payload", capture_output=True, text=True, check=False)
