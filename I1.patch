+@pytest.mark.parametrize("thread_id", ["report-1@lists.example.org", "<report-1@lists.example.org>"])
+@pytest.mark.parametrize("template", [None, "https://lists.example.org/message/{message_id}/"])
+def test_thread_url_accepts_bare_id_and_emits_canonical_id(thread_id: str, template: str | None) -> None:
+    from imap_source.thread_url import resolve_thread_url
+
+    config = make_config(archive_template=template)
+    result = resolve_thread_url(config, thread_id)
+    assert result == resolve_thread_url(config, "<report-1@lists.example.org>")
+    assert result["thread_id"] == "<report-1@lists.example.org>"
+    expected = (
+        "https://lists.example.org/message/report-1%40lists.example.org/"
+        if template else "imap://imap.example.org/INBOX;MSGID=report-1%40lists.example.org"
+    )
+    assert result["url"] == expected
