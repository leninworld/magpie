+"""Caller ID parity through the real CLI operation boundary, with synthetic mail."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from conftest import FakeMailbox, build_message, make_config
+from imap_source.read_thread import main as read_main
+
+
+@pytest.mark.parametrize("thread_id", ["<report@example.org>", "report@example.org"])
+def test_read_cli_accepts_bare_id(thread_id: str, monkeypatch: pytest.MonkeyPatch,
+                                 capsys: pytest.CaptureFixture[str]) -> None:
+    root = "<report@example.org>"
+    box = FakeMailbox.seed(INBOX=[build_message(root, "report", "reporter@example.org")])
+    monkeypatch.setattr("imap_source.cli.load_config", make_config)
+    monkeypatch.setattr("imap_source.cli.Mailbox.connect", lambda _config: box)
+    assert read_main([thread_id]) == 0
+    payload = json.loads(capsys.readouterr().out)
+    assert payload["thread_id"] == root
+    assert payload["message_count"] == 1
+    assert "body_raw" not in payload["messages"][0]
